<%- include("partials/header") %>

<section>
  <h1 class="text-3xl font-bold text-maroon">Log in</h1>

  <% if (error) { %>
    <p class="mt-3 font-medium text-red-800" role="alert"><%= error %></p>
  <% } %>

  <form method="POST" action="/login" class="mt-5 grid gap-4">
    <label class="block font-medium">Username <input name="username" required autocomplete="username" class="mt-1 block w-full rounded border border-ink/40 bg-white px-3 py-2 text-base font-normal focus:border-maroon focus:outline-2 focus:outline-maroon"></label>
    <label class="block font-medium">Password <input type="password" name="password" required autocomplete="current-password" class="mt-1 block w-full rounded border border-ink/40 bg-white px-3 py-2 text-base font-normal focus:border-maroon focus:outline-2 focus:outline-maroon"></label>
    <button type="submit" class="cursor-pointer rounded bg-maroon px-4 py-3 font-semibold text-white hover:bg-maroon-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-maroon">Log in</button>
  </form>

  <p class="mt-4">Don't have an account? <a href="/signup" class="font-medium text-maroon underline hover:text-maroon-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-maroon">Sign up</a></p>
</section>

<%- include("partials/footer") %>